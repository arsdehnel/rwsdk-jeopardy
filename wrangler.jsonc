{
	// Schema reference for wrangler configuration
	"$schema": "node_modules/wrangler/config-schema.json",

	// Name of your worker
	"name": "rwsdk-jeopardy",

	// Entry point for your worker
	"main": "src/worker.tsx",

	// Compatibility settings
	"compatibility_date": "2025-08-21",
	"compatibility_flags": ["nodejs_compat"],

	// Assets configuration
	"assets": {
		"binding": "ASSETS"
	},

	// Observability settings
	"observability": {
		"enabled": true
	},

	// Environment variables
	"vars": {
		"WEBAUTHN_APP_NAME": "kad-jeopardy",
		"RWSDK_JEOPARDY_ENV": "development",
		"LOG_LEVEL": "debug",
		"LOG_LEVEL_TASK_OVERRIDE": ""
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION_DURABLE_OBJECT",
				"class_name": "SessionDurableObject"
			},
			{
				"name": "GAME_STATE_SYNC_DURABLE_OBJECT",
				"class_name": "GameStateSyncDurableObject"
			}
		]
	},
	"exports": {
		"GameStateSyncDurableObject": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"SessionDurableObject": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"SyncedStateServer": {
			"type": "durable-object",
			"state": "deleted"
		}
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"analytics_engine_datasets": [
		{
			"binding": "AED_LOGIN_ATTEMPTS",
			"dataset": "login_attempts_local"
		},
		{
			"binding": "AED_SESSION_LIFECYCLE",
			"dataset": "session_lifecycle_local"
		}
	],
	"d1_databases": [
		{
			"binding": "D1_JEOPARDY",
			"database_name": "jeopardy-local",
			"database_id": "local",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	],
	"env": {
		"integration": {
			"ai": {
				"binding": "AI"
			},
			"vars": {
				"RWSDK_JEOPARDY_ENV": "integration",
				"WEBAUTHN_APP_NAME": "kad-jeopardy"
			},
			"d1_databases": [
				{
					"binding": "D1_JEOPARDY",
					"database_id": "a86dcb3d-4605-42ba-afec-50d19caad546",
					"database_name": "jeopardy-integration",
					"migrations_dir": "drizzle",
					"migrations_pattern": "drizzle/*/migration.sql"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "AED_LOGIN_ATTEMPTS",
					"dataset": "login_attempts_integration"
				},
				{
					"binding": "AED_SESSION_LIFECYCLE",
					"dataset": "session_lifecycle_local"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "SESSION_DURABLE_OBJECT",
						"class_name": "SessionDurableObject"
					},
					{
						"name": "GAME_STATE_SYNC_DURABLE_OBJECT",
						"class_name": "GameStateSyncDurableObject"
					}
				]
			}
		},
		"staging": {
			"ai": {
				"binding": "AI"
			},
			"vars": {
				"RWSDK_JEOPARDY_ENV": "staging",
				"WEBAUTHN_APP_NAME": "kad-jeopardy"
			},
			"d1_databases": [
				{
					"binding": "D1_JEOPARDY",
					"database_id": "a86dcb3d-4605-42ba-afec-50d19caad546",
					"database_name": "jeopardy-staging",
					"migrations_dir": "drizzle",
					"migrations_pattern": "drizzle/*/migration.sql"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "AED_LOGIN_ATTEMPTS",
					"dataset": "login_attempts_staging"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "SESSION_DURABLE_OBJECT",
						"class_name": "SessionDurableObject"
					},
					{
						"name": "GAME_STATE_SYNC_DURABLE_OBJECT",
						"class_name": "GameStateSyncDurableObject"
					}
				]
			}
		},
		"production": {
			"vars": {
				"RWSDK_JEOPARDY_ENV": "production",
				"WEBAUTHN_APP_NAME": "kad-jeopardy"
			}
		}
	}
}
